{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/assets/$1"
    },
    {
      "source": "/img/(.*)",
      "destination": "/frontend/dist/img/$1"
    },
    {
      "source": "/videos/(.*)",
      "destination": "/frontend/dist/videos/$1"
    },
    {
      "source": "/(.*\\.[a-z0-9]+)$",
      "destination": "/frontend/dist/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
